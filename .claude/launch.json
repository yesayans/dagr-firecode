{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dagr-api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["src.main:app", "--host", "127.0.0.1", "--port", "8000", "--app-dir", "api"],
      "port": 8000
    },
    {
      "name": "dagr-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    }
  ]
}
