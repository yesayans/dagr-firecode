# ---------------------------------------------------------------------------
# LLM - any OpenAI-compatible endpoint (third-party router, vLLM, OpenAI itself)
# ---------------------------------------------------------------------------
# Structured output is requested in the prompt and validated with pydantic, so
# the endpoint does NOT need to support response_format=json_schema.
LLM_BASE_URL=https://autorouter.io/v1
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3
LLM_TIMEOUT_S=60

# Sent instead of the OpenAI SDK's own User-Agent. Not cosmetic: autorouter.io
# sits behind a WAF that returns 403 for any agent matching "OpenAI/Python*".
# Leave empty to keep the SDK default.
HTTP_USER_AGENT=aipm/0.1.0

# ---------------------------------------------------------------------------
# Embeddings - configured independently of the LLM
# ---------------------------------------------------------------------------
# api      -> OpenAI-compatible /embeddings endpoint (EMBED_BASE_URL/EMBED_API_KEY)
# local    -> sentence-transformers, falling back to TF-IDF + TruncatedSVD
# fixture  -> deterministic hashed vectors; offline, for tests and CI
EMBED_BACKEND=local

# Leave EMBED_MODEL / EMBED_DIM unset to let the active backend resolve its own
# defaults. Setting them overrides the backend default.
# EMBED_MODEL=
# EMBED_DIM=
EMBED_BATCH_SIZE=256

# Only used when EMBED_BACKEND=api. Defaults to the LLM values if unset.
# EMBED_BASE_URL=
# EMBED_API_KEY=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
STORAGE_BACKEND=sqlite

# ---------------------------------------------------------------------------
# Demo precompute (scripts/precompute_demo.py)
# ---------------------------------------------------------------------------
DEMO_N_APPS=8
DEMO_MAX_REVIEWS_PER_APP=4000
DEMO_MODE=true
