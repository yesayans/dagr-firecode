# OpenRouter (LLM latent-need extraction).
# Absent → quote representative need-bearing reviews (need_source=representative_review).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# GitHub API (issues/milestones + repo search).
# Prefer leaving this empty locally and using the git credential helper instead —
# never copy a PAT into this file if git credential fill already has one.
GITHUB_TOKEN=

# When GITHUB_TOKEN is unset, shell out to `git credential fill` for github.com
# (in-memory only; never written to disk). Set false to force anonymous GitHub.
GITHUB_TOKEN_FROM_GIT_CREDENTIAL=true

# Supabase (service role). Both required for remote store; else LocalJsonStore.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Embeddings: tfidf (default, offline) | minilm (needs requirements-embeddings.txt)
EMBEDDING_BACKEND=tfidf
# Calibrated (char_wb 3-5 + boilerplate strip, 192 AntennaPod items): admits all 5
# labelled true matches (min true top-1 ~0.181). Recall floor only - an ambiguous
# probe reaches ~0.191, so precision comes from top-1 + MATCH_MARGIN_TFIDF.
MATCH_THRESHOLD_TFIDF=0.18
MATCH_MARGIN_TFIDF=0.015
MATCH_THRESHOLD_MINILM=0.45
MATCH_MARGIN_MINILM=0.05
# Legacy alias; ignored when per-backend thresholds are set
MATCH_THRESHOLD=0.45

# Review ingestion
MAX_REVIEWS=2000
HF_DATASET=sealuzh/app_reviews
